local function useemj(message)
for code, emoji in pairs(emojis) do
message = message:gsub(code, emoji)
end
return message
end
local function didujschat(chatText)
local texttoreplace = useemj(chatText)
return texttoreplace
end
local thechatbox = game:GetService("Players").LocalPlayer.PlayerGui.Chat.Frame.ChatBarParentFrame.Frame.BoxFrame.Frame.ChatBar or nil
if thechatbox then
thechatbox:GetPropertyChangedSignal("Text"):Connect(function()
local text = thechatbox.Text
local emojithatwasused = useemj(text)
if emojithatwasused ~= text then
 thechatbox.Text = emojithatwasused
end
end)
end
local chatted = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
if chatted and chatted.SayMessageRequest then
chatted.SayMessageRequest.OnClientEvent:Connect(function(message, channel)
local nmsg = useemj(message)
chatted.SayMessageRequest:FireServer(nmsg, channel)
end)
end
